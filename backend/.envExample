# Copy this file to .env and fill in your own values.
# Never commit real credentials.

PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Task-Manager

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Token a new admin has to provide while signing up
ADMIN_INVITE_TOKEN=change-me

# Public URL of this API (used in outgoing links)
BASE_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
